                    </p>
                    <Link href={`/user/user-detail-job/${job.post_id}`}>
                      <button className={styles.detailBtn}>ดูรายละเอียด</button>
                    </Link>
                  </div>
                </div>
              ))
            )}
          </div>

          {/* รีวิวบริษัท */}
          <ReviewSection
            reviews={reviews}
            viewerId={viewer?.id}
            onDeleteReview={deleteReview}
          />
        </div>
      </div>
    </div>
  );
}
