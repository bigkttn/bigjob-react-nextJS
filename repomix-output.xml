            {posts.length === 0 ? (
              <p style={{ color: "#888" }}>ยังไม่มีตำแหน่งงานที่เปิดรับ</p>
            ) : (
              posts.map((job: any) => (
                <div key={job.post_id} className={styles.jobCard}>
                  <img
                    src={
                      company.logo_image ||
                      `https://ui-avatars.com/api/?name=${encodeURIComponent(company.company_name || "Company")}&background=random`
                    }
