              onKeyDown={handleSearchKeyDown}
              onFocus={() => setShowHistory(true)}
              placeholder="ค้นหาชื่อผู้สมัคร, ตำแหน่งงานที่สนใจ หรือจังหวัด (รองรับ AI Semantic Search)..."
