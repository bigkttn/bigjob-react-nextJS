                  priority
                  unoptimized
                />
              </div>
              <strong>
                <h2 className={styles.name}>{fmt(profile.fullname)}</h2>
              </strong>
              <strong>
                <p className={styles.email}>{fmt(profile.email)}</p>
              </strong>

              <div className={styles.detailsBox}>
                <div className={styles.titleinfoRow}>
                  <strong>เกี่ยวกับ</strong>
                </div>
                {[
