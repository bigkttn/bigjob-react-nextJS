  cursor: pointer;
  font-weight: bold;
  transition: background 0.2s;
}

.closeModalBtn:hover {
  background: #b02a37;
}

.modalBody {
  flex: 1;
  padding: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
