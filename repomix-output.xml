                `https://ui-avatars.com/api/?name=${encodeURIComponent(company.company_name || "Company")}&background=random`
              }
              className={styles.banner}
              alt="ภาพหน้าปกบริษัท"
            />

            <div className={styles.logoWrapper}>
              <img
                src={
                  company.logo_image ||
