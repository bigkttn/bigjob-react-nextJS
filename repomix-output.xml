                  <div>
                    <h2>{fmt(job.job_position)}</h2>
                    <p>
                      <strong>รายละเอียดงาน:</strong> {fmt(job.job_description)}
                    </p>
                    <p>
                      <strong>เงินเดือน:</strong> {fmt(job.salary_min)} -{" "}
