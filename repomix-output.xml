                <div
                  className={styles.titleinfoRow}
                  style={{ marginTop: "12px" }}
                >
                  <strong>ช่องทางการติดต่อ</strong>
                </div>
                {[
                  { label: "Line ID", key: "line_id" },
                  { label: "ประเทศ", key: "country" },
                  { label: "จังหวัด", key: "province" },
