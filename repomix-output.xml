                  viewer?.company_name ||
                  "invaid Company"
                }
                seekerName={profile.fullname || "invaid Seeker"}
                jobTitle={jobTitle || profile.job_titles?.[0]?.job_name}
                seekerEmail={profile.email || ""}
                companyEmail={viewer.email || ""}
                companyJobs={companyJobs}
              />
