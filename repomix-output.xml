}

.menuContainer {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 20;
}

.actionMenuBtn {
  background: none;
  border: none;
  cursor: pointer;
  color: #6b7280;
  display: flex;
  align-items: center;
