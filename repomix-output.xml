        กรุณาให้คะแนนและแสดงความคิดเห็น
      </p>

      {/* ส่วนเลือกดาว */}
      <div style={{ display: "flex", justifyContent: "center", gap: "10px", marginBottom: "22px" }}>
  {[1, 2, 3, 4, 5].map((star) => {
    const isFilled = star <= reviewRating;
    return (
      <button
        type="button"
        key={star}
        onClick={() => setReviewRating(star)}
        style={{
          background: "none",
          border: "none",
          padding: 0,
          cursor: "pointer",
          outline: "none",
          transition: "transform 0.15s ease",
        }}
