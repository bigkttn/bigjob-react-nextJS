                  cursor: "pointer",
                  fontSize: "14px"
                }}
              >
                ยกเลิก
              </button>
              <button
                onClick={() => handleReport(selectedType as ReportType, description)}
                style={{
                  padding: "8px 16px",
                  borderRadius: "6px",
