  color: #334155;
  transition: border-color 0.2s;
}

/* ช้อยส์ที่ผู้สมัครเลือก และถูกต้อง */
.choiceSelectedCorrect {
  background-color: #ecfdf5;
  border-color: #22c55e;
  color: #14532d;
  font-weight: 600;
}

/* ช้อยส์ที่ผู้สมัครเลือก แต่ผิด */
.choiceSelectedIncorrect {
  background-color: #fef2f2;
  border-color: #ef4444;
  color: #7f1d1d;
  font-weight: 600;
}

/* ช้อยส์เฉลยที่ถูกต้อง เมื่อผู้สมัครตอบข้ออื่น */
.choiceCorrectAnswer {
  background-color: #f0fdf4;
  border-color: #86efac;
  border-style: dashed;
  color: #166534;
  font-weight: 500;
}

.choiceTag {
  font-size: 11px;
  padding: 2px 8px;
  border-radius: 4px;
  font-weight: 600;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 4px;
}

.tagCorrect {
  background-color: #16a34a;
  color: #ffffff;
}

.tagIncorrect {
  background-color: #ef4444;
  color: #ffffff;
}

.tagAnswerKey {
  background-color: #dcfce7;
  color: #15803d;
  border: 1px solid #86efac;
}

.modalFooter {
  padding: 14px 24px;
  border-top: 1px solid #e5e7eb;
  background-color: #f8fafc;
  display: flex;
  justify-content: flex-end;
}

.btnClose {
  background-color: #64748b;
  color: #ffffff;
  padding: 8px 20px;
  border-radius: 8px;
  border: none;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background-color 0.2s;
}

.btnClose:hover {
  background-color: #475569;
}

/* Loading & Empty States */
.stateContainer {
  padding: 40px 20px;
  text-align: center;
  color: #64748b;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.stateIcon {
  font-size: 48px;
  color: #94a3b8;
}

.stateText {
  font-size: 15px;
  color: #475569;
  margin: 0;
}

.spinner {
  width: 36px;
  height: 36px;
  border: 3px solid #e2e8f0;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
</file>

