                    </td>
                  </tr>
                </tbody>
              </table>

              <div style={{ marginTop: "30px" }}>
                <hr />
                <h3 className={styles.sectionTitle}>คุณสมบัติ</h3>
                <div
                  style={{
                    maxWidth: "450px",
                    whiteSpace: "pre-line",
                    wordBreak: "break-word",
