  }
}

.skeletonBlock {
  border-radius: 8px;
  animation: shimmer 1.6s infinite linear;
  background-color: #d9d9d9;
  background-image: linear-gradient(
    90deg,
    #d9d9d9 0%,
    #efefef 40%,
    #d9d9d9 80%
