                        JOIN company ON posts.company_id = company.company_id WHERE posts.post_id = ?`; // ตัวอย่าง SQL ที่คุณต้องการใช้
        const [posts]: any = await db.query(sql, [post_id]); // แทนที่ ? ด้วยค่า post_id ที่ต้องการ

