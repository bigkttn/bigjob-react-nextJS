                  </tr>
                  <tr>
                    <td className={styles.label}>ประเภทงาน</td>
                    <td>{job.job_type || "ไม่ระบุ"}</td>
                  </tr>
                  <tr>
                    <td className={styles.label}>จำนวนที่รับ</td>
                    <td>{job.vacancy || 1} ตำแหน่ง</td>
                  </tr>
                  <tr>
                    <td className={styles.label}>รายละเอียดงาน</td>
                    <td>
                      <div
                        style={{
                          maxWidth: "450px",
