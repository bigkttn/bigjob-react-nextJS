                  fontFamily: "inherit",
                  resize: "none",
                  outline: "none"
                }}
              />
            </div>

            {/* ปุ่มกดยืนยันหรือยกเลิก */}
            <div style={{ display: "flex", justifyContent: "flex-end", gap: "10px", marginTop: "10px" }}>
              <button
                onClick={() => setIsModalOpen(false)}
