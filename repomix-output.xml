        return NextResponse.json({ users }, { status: 200 });

    } catch (error) {
        // ถ้า Token หมดอายุหรือผิดพลาด ให้มองว่าไม่ได้ล็อกอิน
        return NextResponse.json({ users: null }, { status: 200 });
    }
}
